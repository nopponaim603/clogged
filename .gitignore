# =========================================================================
# Unity Project .gitignore
# GitHub Unity standard ignore rules + multi-project support
# Reference: https://github.com/github/gitignore/blob/main/Unity.gitignore
# =========================================================================

# Unity temporary & generated folders (matches root or subdirectories like Unity-Projects/, Unity-Day-mission/, etc.)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
ServerData/

# Addressables & Visual Scripting generated files
[Aa]ssets/Plugins/Editor/JetBrains*
[Aa]ssets/StreamingAssets/aa*
[Aa]ssets/AddressableAssetsData/link.xml*
[Aa]ssets/Addressables_Temp*
[Aa]ssets/AddressableAssetsData/*/*.bin*
[Aa]ssets/Unity.VisualScripting.Generated/*
[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
[Aa]ssets/[Ss]ceneDependencyCache*

# Blender 3D auto-generated backup files
*.blend1
*.blend1.meta

# IDE / Visual Studio / JetBrains / VS Code
.vs/
.gradle/
.idea/
.vscode/
ExportedObj/
.consulo/
*.DotSettings.user

# Autogenerated VS/MD/Consulo solution and C# project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports / system logs
sysinfo.txt
mono_crash.*

# Target build output artifacts
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics & TestRunner
crashlytics-build.properties
InitTestScene*.unity*

# =====================
# OS generated files
# =====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =====================
# AI Gateway local data
# =====================
# 9Router Data
ai-gateway/9router/data/

# OmniRoute Data
ai-gateway/omniroute/data/

# mcp-unity (cloned third-party Unity MCP bridge)
ai-gateway/mcp-unity/
mcp-unity/cloned/

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
